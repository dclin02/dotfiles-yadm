[
    {
        "layer": "top",
        "position": "bottom",
        "output": ["LG Electronics LG ULTRAGEAR+ 403AZVNEG743", "eDP-1"],
        "height": 24,
        "spacing": 0,
        "modules-left": ["sway/workspaces", "sway/mode"],
        "modules-center": [],
        "modules-right": [
            "mpris",
            "disk",
            "memory",
            "cpu",
            "temperature",
            "network",
            "battery",
            "wireplumber",
            "custom/ppd",
            "clock",
            "custom/shutdown",
            "tray"
        ],
        "sway/workspaces": {
            "all-outputs": false,
            "format": "{name}",
            "strip-workspace-numbers": true
        },
        "sway/mode": {
            "format": " {}"
        },
        "mpris": {
          "format": "{player_icon} {dynamic}",
          "format-paused": "{status_icon} <i>{dynamic}</i>",
          "dynamic-len": 40,
          "title-len": 40,
          "player-icons": {
            "default": "▶",
            "mpv": "🎵"
          },
          "status-icons": {
            "paused": "⏸"
          },
        },

        "disk": {
            "format": " {free}",
            "path": "/",
            "interval": 30
        },
        "memory": {
            "format": " {used}G/{total}G ({percentage}%)",
            "interval": 2
        },
        "cpu": {
            "format": " {usage}%",
            "interval": 2
        },
        "temperature": {
            "format": " {temperatureC}°C",
            "critical-threshold": 90,
            "interval": 30
        },
        "network": {
            "format-ethernet": " {bandwidthUpBits}  {bandwidthDownBits}",
            "format-wifi": " {bandwidthUpBits}  {bandwidthDownBits}",
            "format-disconnected": "⚠ disconnected",
            "interval": 2
        },
        "battery": {
            "format": " {capacity}%",
            "format-charging": " {capacity}%",
            "format-plugged": " {capacity}%",
            "interval": 30,
            "states": {
                "warning": 25,
                "critical": 10
            }
        },
        "wireplumber": {
            "format": " {volume}%",
            "format-muted": " muted",
            "on-click": "pavucontrol",
            "scroll-step": 5
        },
        "custom/ppd": {
            "format": "",
            "on-click": "~/.config/i3/scripts/power-profiles",
            "tooltip": false
        },
        "clock": {
            "format": "{:%a %d %b %H:%M:%S}",
            "interval": 1
        },
        "custom/shutdown": {
            "format": "",
            "on-click": "~/.config/i3/scripts/powermenu",
            "tooltip": false
        },
        "tray": {
            "spacing": 5
        }
    },
