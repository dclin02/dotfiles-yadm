[
    {
        "layer": "top",
        "position": "bottom",
        "output": ["DP-6"],
        "height": 24,
        "spacing": 0,
        "modules-left": ["sway/workspaces", "sway/mode"],
        "modules-center": [],
        "modules-right": [
            "custom/mediaplayer",
            "disk",
            "memory",
            "cpu",
            "temperature",
            "network",
            "battery",
            "wireplumber",
            "custom/ppd",
            "clock",
            "custom/shutdown",
            "tray"
        ],

        "sway/workspaces": {
            "all-outputs": false,
            "format": "{name}",
            "strip-workspace-numbers": true
        },
        "sway/mode": {
            "format": " {}"
        },

        "custom/mediaplayer": {
            "exec": "BLOCK_INSTANCE=spotify ~/.config/i3/scripts/mediaplayer",
            "interval": 5,
            "on-click": "playerctl --player=spotify play-pause",
            "on-scroll-up": "playerctl --player=spotify next",
            "on-scroll-down": "playerctl --player=spotify previous",
            "escape": true
        },
        "disk": {
            "format": " {free}",
            "path": "/",
            "interval": 30
        },
        "memory": {
            "format": " {used:0.1f}G",
            "interval": 2
        },
        "cpu": {
            "format": " {usage}%",
            "interval": 2
        },
        "temperature": {
            "format": " {temperatureC}°C",
            "critical-threshold": 90,
            "interval": 30
        },
        "network": {
            "format-ethernet": " {bandwidthUpBits}  {bandwidthDownBits}",
            "format-wifi": " {bandwidthUpBits}  {bandwidthDownBits}",
            "format-disconnected": "⚠ disconnected",
            "interval": 2
        },
        "battery": {
            "format": " {capacity}%",
            "format-charging": " {capacity}%",
            "format-plugged": " {capacity}%",
            "interval": 30,
            "states": {
                "warning": 25,
                "critical": 10
            }
        },
        "wireplumber": {
            "format": " {volume}%",
            "format-muted": " muted",
            "on-click": "pavucontrol",
            "scroll-step": 5
        },
        "custom/ppd": {
            "format": "",
            "on-click": "~/.config/i3/scripts/power-profiles",
            "tooltip": false
        },
        "clock": {
            "format": "{:%a %d %b %H:%M:%S}",
            "interval": 1
        },
        "custom/shutdown": {
            "format": "",
            "on-click": "~/.config/i3/scripts/powermenu",
            "tooltip": false
        },
        "tray": {
            "spacing": 5
        }
    },
