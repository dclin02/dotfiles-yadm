###################
# input / keyboard #
###################

# Keyboard configuration
# CapsLock tap=Escape / hold=Ctrl handled by interception-tools + caps2esc

# Default for all keyboards
input "type:keyboard" {
    xkb_layout us
    repeat_delay 200
    repeat_rate 45
    xkb_numlock enabled
}

# External keyboards (e.g. Keychron): US International with dead keys
input "13364:53297:Keychron__Keychron_Link__Keyboard" {
    xkb_layout us
    xkb_variant intl
    repeat_delay 200
    repeat_rate 45
}

# Laptop built-in keyboard: Brazilian Portuguese, ThinkPad variant
input "1:1:AT_Translated_Set_2_keyboard" {
    xkb_layout br
    xkb_variant thinkpad
    repeat_delay 200
    repeat_rate 45
}

# Toggle laptop keyboard layout: BR ThinkPad <-> US
bindsym $mod+F7 exec swaymsg 'input "1:1:AT_Translated_Set_2_keyboard" xkb_variant ""' && swaymsg 'input "1:1:AT_Translated_Set_2_keyboard" xkb_layout br' && swaymsg 'input "1:1:AT_Translated_Set_2_keyboard" xkb_variant thinkpad'
bindsym $mod+F8 exec swaymsg 'input "1:1:AT_Translated_Set_2_keyboard" xkb_variant ""' && swaymsg 'input "1:1:AT_Translated_Set_2_keyboard" xkb_layout us' && swaymsg 'input "1:1:AT_Translated_Set_2_keyboard" xkb_variant intl'

#############################################
# autostart applications/services on login: #
#############################################

# Pass Wayland env vars to systemd user session and D-Bus so that
# services activated via D-Bus (xdg-desktop-portal, waybar, etc.) have
# access to the display. Must run before anything that needs the portal.
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK

# polkit auth agent
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# dex autostart (environment changed from i3 to sway)
exec dex --autostart --environment sway

# KDE Connect
exec /usr/lib/kdeconnectd
exec kdeconnect-indicator

# Wallpaper (feh replaced with swaybg)
exec swaybg -i /home/daniel.lin/Pictures/JWST/6.jpg -m fill

# Desktop notifications (dunst works in Wayland)
exec /usr/bin/dunst
bindsym $mod+Shift+n exec dunstctl set-paused toggle
bindsym $mod+n exec dunstctl close-all
bindsym $mod+Ctrl+h exec dunstctl history-pop

# Idle / lock / DPMS (replaces xidlehook + xset)
# Locks at 480s, turns off displays at 600s
exec swayidle -w \
    timeout 480 '~/.config/sway/scripts/blur-lock' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep '~/.config/sway/scripts/blur-lock'

# Hide cursor after inactivity (replaces unclutter)
seat * hide_cursor 5000
seat * xcursor_theme Yaru

# Clipboard manager
# xfce4-clipman may work via XWayland; wl-paste+cliphist is a native alternative:
# exec wl-paste --type text --watch cliphist store
# exec wl-paste --type image --watch cliphist store
exec xfce4-clipman
exec copyq --start-server

